#!/usr/bin/env bash

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
source "$HERE/common"

NAME="${1:-}"
MAJOR="${2:-}"
MINOR="${3:-}"
PATCH="${4:-}"

if [[ -z "$NAME" ]]; then
 echo ""
 exit 0
fi

# New rows store culture-null words. An existing row may point at a culture word
# with the same text, and that row is the one returned.
name_id=$("$HERE/GetIdentifier" "$NAME")
major_id=$( [[ -n "$MAJOR" ]] && "$HERE/GetIdentifier" "$MAJOR" || echo "" )
minor_id=$( [[ -n "$MINOR" ]] && "$HERE/GetIdentifier" "$MINOR" || echo "" )
patch_id=$( [[ -n "$PATCH" ]] && "$HERE/GetIdentifier" "$PATCH" || echo "" )

name_esc=$(sql_escape "$NAME")
if [[ -n "$MAJOR" ]]; then
  major_cond="UPPER(maj.value) = UPPER('$(sql_escape "$MAJOR")')"
else
  major_cond="Version.major IS NULL"
fi
if [[ -n "$MINOR" ]]; then
  minor_cond="UPPER(minr.value) = UPPER('$(sql_escape "$MINOR")')"
else
  minor_cond="Version.minor IS NULL"
fi
if [[ -n "$PATCH" ]]; then
  patch_cond="UPPER(pat.value) = UPPER('$(sql_escape "$PATCH")')"
else
  patch_cond="Version.patch IS NULL"
fi

version_id=$(sqlite_query_one "
 SELECT Version.id
 FROM Version
 JOIN Word AS n ON n.id = Version.name
 LEFT JOIN Word AS maj ON maj.id = Version.major
 LEFT JOIN Word AS minr ON minr.id = Version.minor
 LEFT JOIN Word AS pat ON pat.id = Version.patch
 WHERE UPPER(n.value) = UPPER('$name_esc')
  AND $major_cond
  AND $minor_cond
  AND $patch_cond
 ORDER BY Version.id
 LIMIT 1;
")

if [[ -n "$version_id" ]]; then
 echo "$version_id"
 exit 0
fi

insert_result=$(sqlite_run "
 INSERT OR IGNORE INTO Version (name, major, minor, patch)
 VALUES ($name_id,
  ${major_id:-NULL},
  ${minor_id:-NULL},
  ${patch_id:-NULL});
")

# Fetch the id
version_id=$(sqlite_query_one "
 SELECT Version.id
 FROM Version
 JOIN Word AS n ON n.id = Version.name
 LEFT JOIN Word AS maj ON maj.id = Version.major
 LEFT JOIN Word AS minr ON minr.id = Version.minor
 LEFT JOIN Word AS pat ON pat.id = Version.patch
 WHERE UPPER(n.value) = UPPER('$name_esc')
  AND $major_cond
  AND $minor_cond
  AND $patch_cond
 ORDER BY Version.id
 LIMIT 1;
")

echo "${version_id:-}"
