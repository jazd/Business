#!/usr/bin/env bash

# Usage: SetFormat <name>
# Find-or-insert Format by sentence name. Parity with PG SetFormat.

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
source "$HERE/common"

NAME="${1:-}"
if [[ -z "$NAME" ]]; then
 echo "Usage: SetFormat <name>" >&2
 exit 1
fi

name_id=$("$HERE/GetSentence" "$NAME")
if [[ -z "$name_id" ]]; then
 echo ""
 exit 0
fi

format_id=$(sqlite_query_one "SELECT id FROM Format WHERE name = $name_id LIMIT 1;")
if [[ -z "$format_id" ]]; then
 sqlite_run "INSERT INTO Format (name) SELECT $name_id WHERE NOT EXISTS (SELECT 1 FROM Format WHERE name = $name_id);" >/dev/null
 format_id=$(sqlite_query_one "SELECT id FROM Format WHERE name = $name_id LIMIT 1;")
fi
echo "$format_id"
