#!/usr/bin/env bash

# Usage: SetCampaignEvent <campaign_id> <individual_id> <kind> [path_id] [run_id]
# Always appends. kind examples: sent, read, bounce, delivered, returned.

source ~/bin/sqlite/common
ROOT="$(cd "$(dirname "$0")" && pwd)"
CAMPAIGN="${1:-}"
INDIVIDUAL="${2:-}"
KIND="${3:-}"
PATH_ID="${4:-}"
RUN="${5:-}"
if [[ -z "$CAMPAIGN" || -z "$INDIVIDUAL" || -z "$KIND" ]]; then
 echo "Usage: SetCampaignEvent <campaign_id> <individual_id> <kind> [path_id] [run_id]" >&2
 exit 1
fi
kind_id=$("$ROOT/GetWord" "$KIND")
path_sql=$(sql_int_or_null "$PATH_ID")
run_sql=$(sql_int_or_null "$RUN")
sqlite_run "INSERT INTO CampaignEvent (campaign, individual, kind, path, run) VALUES ($CAMPAIGN, $INDIVIDUAL, $kind_id, $path_sql, $run_sql);" >/dev/null
echo "$CAMPAIGN"
