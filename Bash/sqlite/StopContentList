#!/usr/bin/env bash

# Usage: StopContentList <list_name> <content_id>

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
source "$HERE/common"
LIST="${1:-}"
CONTENT="${2:-}"
if [[ -z "$LIST" || -z "$CONTENT" ]]; then
 echo "Usage: StopContentList <list_name> <content_id>" >&2
 exit 1
fi
list_id=$("$HERE/GetWord" "$LIST")
sqlite_run "UPDATE ContentList SET stop = datetime('now') WHERE listName = $list_id AND content = $CONTENT AND stop IS NULL;" >/dev/null
echo "$CONTENT"
