#!/usr/bin/env bash

# Usage: PutAssemblyPart <assembly_id> <part_id> [<designator>] [<quantity>]
# Inserts when no matching row has stop IS NULL. If designator is set and another
# active row differs in part or quantity, sets stop on those rows first.

source ~/bin/sqlite/common

ASSEMBLY_ID="${1:-}"
PART_ID="${2:-}"
DESIGNATOR="${3:-}"
QUANTITY="${4:-}"

if [[ -z "$ASSEMBLY_ID" || -z "$PART_ID" ]]; then
    echo "Error: assembly_id and part_id are required" >&2
    exit 1
fi

if ! [[ "$ASSEMBLY_ID" =~ ^[0-9]+$ ]]; then
    echo "Error: assembly_id must be an integer" >&2
    exit 1
fi

if ! [[ "$PART_ID" =~ ^[0-9]+$ ]]; then
    echo "Error: part_id must be an integer" >&2
    exit 1
fi

if [[ -n "$QUANTITY" ]] && ! [[ "$QUANTITY" =~ ^[0-9]+$ ]]; then
    echo "Error: quantity must be an integer if provided" >&2
    exit 1
fi

designator_id=""
if [[ -n "$DESIGNATOR" ]]; then
    designator_id=$(~/bin/sqlite/GetWord "$DESIGNATOR")
    if [[ -z "$designator_id" ]]; then
        echo "Error: Could not resolve designator '$DESIGNATOR'" >&2
        exit 1
    fi
fi

designator_sql=$(sql_int_or_null "$designator_id")
quantity_sql=$(sql_int_or_null "$QUANTITY")

# Same designator: set stop on other active rows when part/quantity differs
if [[ -n "$designator_id" ]]; then
  sqlite_run "
   UPDATE AssemblyPart
   SET stop = datetime('now')
   WHERE assembly = $ASSEMBLY_ID
    AND designator = $designator_id
    AND stop IS NULL
    AND (
     part != $PART_ID
     OR (
      ($quantity_sql IS NULL AND quantity IS NOT NULL)
      OR ($quantity_sql IS NOT NULL AND (quantity IS NULL OR quantity != $quantity_sql))
     )
    );
  " >/dev/null
fi

exists=$(sqlite_query_one "
 SELECT 1 FROM AssemblyPart
 WHERE assembly = $ASSEMBLY_ID
  AND part = $PART_ID
  AND ((designator = $designator_sql) OR (designator IS NULL AND $designator_sql IS NULL))
  AND ((quantity = $quantity_sql) OR (quantity IS NULL AND $quantity_sql IS NULL))
  AND stop IS NULL
 LIMIT 1;
")

if [[ -z "$exists" ]]; then
  sqlite_run "
   INSERT INTO AssemblyPart (assembly, part, designator, quantity, stop)
   VALUES ($ASSEMBLY_ID, $PART_ID, $designator_sql, $quantity_sql, NULL);
  " >/dev/null
fi

exit 0
