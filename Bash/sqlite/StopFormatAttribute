#!/usr/bin/env bash

# Usage: StopFormatAttribute <format_id> <name> [value] [target]

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
source "$HERE/common"

FORMAT="${1:-}"
NAME="${2:-}"
VALUE="${3:-}"
TARGET="${4:-}"

if [[ -z "$FORMAT" || -z "$NAME" ]]; then
 echo "Usage: StopFormatAttribute <format_id> <name> [value] [target]" >&2
 exit 1
fi

name_id=$("$HERE/GetWord" "$NAME")
value_sql="NULL"
target_sql="NULL"
[[ -n "$VALUE" ]] && value_sql=$("$HERE/GetWord" "$VALUE")
[[ -n "$TARGET" ]] && target_sql=$("$HERE/GetWord" "$TARGET")

sqlite_run "
 UPDATE FormatAttribute
 SET stop = datetime('now')
 WHERE format = $FORMAT AND name = $name_id
  AND ((value = $value_sql) OR (value IS NULL AND $value_sql IS NULL))
  AND ((target = $target_sql) OR (target IS NULL AND $target_sql IS NULL))
  AND stop IS NULL;
" >/dev/null
echo "$FORMAT"
