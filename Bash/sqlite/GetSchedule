#!/usr/bin/env bash

# Usage: GetSchedule <schedule_name>
# Parity with PG GetSchedule.

source ~/bin/sqlite/common

NAME="${1:-}"
if [[ -z "$NAME" ]]; then
  echo ""
  exit 0
fi

name_id=$(~/bin/sqlite/GetSentence "$NAME")
if [[ -z "$name_id" ]]; then
  echo ""
  exit 0
fi

sch_id=$(sqlite_query_one "SELECT schedule FROM ScheduleName WHERE name = $name_id LIMIT 1;")
if [[ -n "$sch_id" ]]; then
  echo "$sch_id"
  exit 0
fi

sqlite_run "INSERT INTO ScheduleName (name) VALUES ($name_id);" >/dev/null
sqlite_query_one "SELECT schedule FROM ScheduleName WHERE name = $name_id LIMIT 1;"
