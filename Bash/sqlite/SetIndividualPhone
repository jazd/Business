#!/usr/bin/env bash

# Usage: SetIndividualPhone <individual_id> <phone_id> [type_word]
# Schema helper (same soft-stop pattern as SetIndividualEmail; no PG procedure yet).

source ~/bin/sqlite/common

IND="${1:-}"
PHONE="${2:-}"
TYPE="${3-}"

if [[ -z "$IND" || -z "$PHONE" ]]; then
  echo "Usage: SetIndividualPhone <individual_id> <phone_id> [type]" >&2
  exit 1
fi

type_sql="NULL"
if [[ -n "$TYPE" ]]; then
  type_id=$(~/bin/sqlite/GetWord "$TYPE")
  type_sql=$(sql_int_or_null "$type_id")
fi

exists=$(sqlite_query_one "
 SELECT 1 FROM IndividualPhone
 WHERE individual = $IND AND phone = $PHONE
  AND ((type = $type_sql) OR (type IS NULL AND $type_sql IS NULL))
  AND stop IS NULL
 LIMIT 1;
")
if [[ -z "$exists" ]]; then
  sqlite_run "
   INSERT INTO IndividualPhone (individual, phone, type)
   VALUES ($IND, $PHONE, $type_sql);
  " >/dev/null
fi

sqlite_run "
 UPDATE IndividualPhone
 SET stop = datetime('now')
 WHERE individual = $IND
  AND phone != $PHONE
  AND stop IS NULL
  AND ((type = $type_sql) OR (type IS NULL AND $type_sql IS NULL));
" >/dev/null

echo "$IND"
