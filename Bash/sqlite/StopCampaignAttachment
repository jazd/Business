#!/usr/bin/env bash

# Usage: StopCampaignAttachment <campaign_id> <path_id> [type] [target]

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
source "$HERE/common"
CAMPAIGN="${1:-}"
PATH_ID="${2:-}"
TYPE="${3:-}"
TARGET="${4:-}"
if [[ -z "$CAMPAIGN" || -z "$PATH_ID" ]]; then
 echo "Usage: StopCampaignAttachment <campaign_id> <path_id> [type] [target]" >&2
 exit 1
fi
type_sql="NULL"
target_sql="NULL"
[[ -n "$TYPE" ]] && type_sql=$("$HERE/GetWord" "$TYPE")
[[ -n "$TARGET" ]] && target_sql=$("$HERE/GetWord" "$TARGET")
sqlite_run "
 UPDATE CampaignAttachment SET stop = datetime('now')
 WHERE campaign = $CAMPAIGN AND path = $PATH_ID
  AND ((type = $type_sql) OR (type IS NULL AND $type_sql IS NULL))
  AND ((target = $target_sql) OR (target IS NULL AND $target_sql IS NULL))
  AND stop IS NULL;
" >/dev/null
echo "$CAMPAIGN"
