#!/usr/bin/env bash

# Usage: RevokePathPassword <path_id> <password_id>
# Sets revoked on the current unrevoked row for that pair only.
# Parity with PG RevokePathPassword.

source ~/bin/sqlite/common

PATH_ID="${1:-}"
PASSWORD_ID="${2:-}"

if [[ -z "$PATH_ID" || -z "$PASSWORD_ID" ]]; then
  echo "Usage: RevokePathPassword <path_id> <password_id>" >&2
  exit 1
fi

sqlite_run "
 UPDATE PathPassword
 SET revoked = datetime('now')
 WHERE path = $PATH_ID
  AND password = $PASSWORD_ID
  AND revoked IS NULL;
" >/dev/null

echo "$PATH_ID"
