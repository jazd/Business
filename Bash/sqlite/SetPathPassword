#!/usr/bin/env bash

# Usage: SetPathPassword <path_id> <password_id>
# Append if no unrevoked row for (path, password). Parity with PG SetPathPassword.

source ~/bin/sqlite/common

PATH_ID="${1:-}"
PASSWORD_ID="${2:-}"

if [[ -z "$PATH_ID" || -z "$PASSWORD_ID" ]]; then
  echo "Usage: SetPathPassword <path_id> <password_id>" >&2
  exit 1
fi

exists=$(sqlite_query_one "
 SELECT 1 FROM PathPassword
 WHERE path = $PATH_ID AND password = $PASSWORD_ID
  AND revoked IS NULL
 LIMIT 1;
")
if [[ -z "$exists" ]]; then
  sqlite_run "
   INSERT INTO PathPassword (path, password)
   VALUES ($PATH_ID, $PASSWORD_ID);
  " >/dev/null
fi

echo "$PATH_ID"
