#!/usr/bin/env bash

# Usage: StopCampaign <campaign_id>
# Fills stop on the open run only.

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
source "$HERE/common"
CAMPAIGN="${1:-}"
if [[ -z "$CAMPAIGN" ]]; then
 echo "Usage: StopCampaign <campaign_id>" >&2
 exit 1
fi
sqlite_run "UPDATE CampaignRun SET stop = datetime('now') WHERE campaign = $CAMPAIGN AND stop IS NULL;" >/dev/null
echo "$CAMPAIGN"
